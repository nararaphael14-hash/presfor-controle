# --- Extraction ---
# Clé API Anthropic (https://console.anthropic.com). Sans clé : repli automatique sur Tesseract local.
ANTHROPIC_API_KEY=
# Modèle de vision (un modèle plus léger, ex. claude-haiku-5-5, réduit le coût ; à valider sur vos scans)
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto | claude | tesseract
EXTRACTOR_BACKEND=auto
# Langues Tesseract (installer fra : voir README)
TESSERACT_LANG=fra+eng
# Extractions parallèles
WORKERS=4

# --- Seuils de comparaison (0-100, sauf MIN_CONFIDENCE 0-1) ---
NAME_TOLERATE=90
NAME_CLOSE=80
LINK_THRESHOLD=80
MIN_CONFIDENCE=0.6

# --- Dossiers de travail ---
# CACHE_DIR=./data/cache
# JOBS_DIR=./data/jobs

# Campagnes (contrats, scans importés, extractions) — volume persistant en production
# DATA_DIR=./data
# Persistance externe (stockage S3 compatible) — facultatif
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
